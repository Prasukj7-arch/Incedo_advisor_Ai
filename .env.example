# Advisor AI — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# AWS API Gateway key (from API Gateway console → Usage Plans → API Keys)
ADVISOR_AI_KEY=your_api_key_here

# EC2 private IP of the RAG server (use 'localhost' if running everything on one server)
EC2_RAG_IP=localhost

# Web UI credentials — set these to something strong for production
WEB_USERNAME=your_username_here
WEB_PASSWORD=your_strong_password_here
